  <script>
    // ====== CONFIG: update API_ENDPOINT after you deploy the serverless function ======
    let API_ENDPOINT = 'https://YOUR_SERVERLESS_ENDPOINT_HERE/api/chat';
    // ==================================================================================

    const msgsEl = document.getElementById('msgs');
    const queryEl = document.getElementById('query');
    const sendBtn = document.getElementById('sendBtn');

    function appendMessage(text, from='bot'){
      const div = document.createElement('div');
      div.className = 'message ' + (from==='me' ? 'me' : 'bot');
      div.innerHTML = '<div class="small">'+(from==='me' ? 'You' : 'Cadet Assistant')+'</div><div style="white-space:pre-wrap">'+escapeHtml(text)+'</div>';
      msgsEl.appendChild(div);
      msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    function escapeHtml(s){ return s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;'); }

    async function send(query){
      if(!query) return;
      appendMessage(query,'me');
      appendMessage('Thinking — generating a response tailored to West Point cadets...','bot');

      // Build a rich request with the cadet system prompt
      const profile = {
        goal: document.getElementById('ptype').value,
        available_minutes: Number(document.getElementById('avail').value || 120),
        env: document.getElementById('env').value,
        injury: document.getElementById('injury').value || 'none'
      };

      try{
        const res = await fetch(API_ENDPOINT, {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            prompt: query,
            profile
          })
        });

        if(!res.ok){
          const txt = await res.text();
          throw new Error('Server error: '+res.status+' '+txt);
        }

        const data = await res.json();
        // assume server returns { reply: '...' }
        // Remove last placeholder 'Thinking' message and append real reply
        // Remove last bot message (thinking)
        const botMsgs = Array.from(msgsEl.querySelectorAll('.bot'));
        if(botMsgs.length) botMsgs[botMsgs.length-1].remove();
        appendMessage(data.reply || 'No reply received.');

      }catch(err){
        // Remove last placeholder bot message
        const botMsgs = Array.from(msgsEl.querySelectorAll('.bot'));
        if(botMsgs.length) botMsgs[botMsgs.length-1].remove();
        appendMessage('Error: '+err.message,'bot');
      }
    }

    sendBtn.addEventListener('click', ()=>{ send(queryEl.value); queryEl.value=''; queryEl.focus(); });
    queryEl.addEventListener('keydown',(e)=>{ if(e.key==='Enter'){ send(queryEl.value); queryEl.value=''; } });

    // Apply profile button
    document.getElementById('applyProfile').addEventListener('click', ()=>{
      appendMessage('Profile applied. I will design responses around the selected goal and the 2-hour limit.','bot');
    });

    // Preset buttons
    document.querySelectorAll('.preset-btn').forEach(b=>{
      b.addEventListener('click',()=>{ queryEl.value = b.dataset.prompt; queryEl.focus(); });
    });

    // Load a short welcome message
    appendMessage("Welcome — I'm the Cadet Fitness Assistant. Tell me your goal or pick a quick prompt. I'll always assume a 2-hour/day training limit and West Point constraints.", 'bot');

  </script>

